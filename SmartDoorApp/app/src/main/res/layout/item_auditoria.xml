<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTipoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FEF3F2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="SEGURIDAD"
                android:textColor="#B42318"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFechaEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="2026-11-08 21:30:00"
                android:textColor="#667085"
                android:textSize="12sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvNombreEvento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Apertura autorizada de puerta"
            android:textColor="#101828"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalleUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Operador: usuario@correo.cl (RUT: 12.345.678-9)"
            android:textColor="#475467"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>