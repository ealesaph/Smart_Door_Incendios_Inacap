<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_orange_gradient"
    tools:ignore="Typos">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Título principal de la app -->
        <TextView
            android:id="@+id/tvTituloSmartDoor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_smartdoor"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:gravity="center"
            android:layout_gravity="center" />

        <!-- Subtítulo / Ingreso de usuario -->
        <TextView
            android:id="@+id/tvSubtituloIngreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="@string/titulo_ingreso"
            android:textColor="#F5F5F5"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_gravity="center" />

        <!-- Tarjeta de Formulario de Login -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <EditText
                    android:id="@+id/etUsuarioRut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:hint="@string/hint_usuario"
                    android:inputType="text"
                    android:autofillHints="username"
                    android:textColor="#1A252C"
                    android:textColorHint="#757575"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:hint="@string/hint_contrasena"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:textColor="#1A252C"
                    android:textColorHint="#757575"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/btn_ingresar"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/orange_gradient_center" />

                <TextView
                    android:id="@+id/tvCrearCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:text="@string/txt_crear_cuenta"
                    android:textColor="@color/orange_gradient_center"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>