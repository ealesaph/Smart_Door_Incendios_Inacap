<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".PlanoActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prototipo"
                android:textColor="#263238"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/titulo_plano"
                android:textColor="#101828"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitulo_plano"
                android:textColor="#667085"
                android:textSize="14sp" />

            <!-- Card de Simulación de Nivel de Incendio en Plano -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simular Nivel de Llama en Plano"
                        android:textColor="#101828"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSimularPlanoBaja"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:text="Baja"
                            android:textColor="#12B76A"
                            android:textSize="12sp"
                            app:strokeColor="#12B76A" />

                        <Button
                            android:id="@+id/btnSimularPlanoMedia"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:text="Media"
                            android:textColor="#F79009"
                            android:textSize="12sp"
                            app:strokeColor="#F79009" />

                        <Button
                            android:id="@+id/btnSimularPlanoAlta"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:text="Alta"
                            android:textColor="#D92D20"
                            android:textSize="12sp"
                            app:strokeColor="#D92D20" />

                        <Button
                            android:id="@+id/btnSimularPlanoNormal"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1"
                            android:text="Normal"
                            android:textColor="#344054"
                            android:textSize="12sp"
                            app:strokeColor="#D0D5DD" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Banner Alerta Crítica (Llama Alta) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlertaCriticaPlano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FEF3F2"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡ALERTA CRÍTICA: RIESGO EXTREMO DE INCENDIO!"
                        android:textColor="#B42318"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="La temperatura actual supera el nivel de seguridad. La apertura no autorizada de puertas en esta zona puede provocar desoxigenación acelerada o propagación de la llama. Proceda únicamente bajo estricta autorización."
                        android:textColor="#912018"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta Croquis del Plano -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Planta 2"
                            android:textColor="#101828"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="#FEF3F2"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="2 alertas"
                            android:textColor="#B42318"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Representación Visual del Plano por Cuadros -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="16dp"
                        android:background="#EAECF0"
                        android:columnCount="3"
                        android:padding="2dp"
                        android:rowCount="2">

                        <!-- Puerta 01 -->
                        <LinearLayout
                            android:id="@+id/boxP01"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:background="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Oficinas A"
                                android:textColor="#667085"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvEstadoCuadroP01"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="#EDFDF5"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="01 Cerrada"
                                android:textColor="#027A48"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Puerta 02 -->
                        <LinearLayout
                            android:id="@+id/boxP02"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:background="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sala técnica"
                                android:textColor="#667085"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvEstadoCuadroP02"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="#EDFDF5"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="02 Cerrada"
                                android:textColor="#027A48"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Puerta 03 -->
                        <LinearLayout
                            android:id="@+id/boxP03"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:background="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Escalera B"
                                android:textColor="#667085"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvEstadoCuadroP03"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="#EDFDF5"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="03 Cerrada"
                                android:textColor="#027A48"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Puerta 04 (Dinámica / Alerta) -->
                        <LinearLayout
                            android:id="@+id/boxP04"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:background="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Escalera A"
                                android:textColor="#667085"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvEstadoCuadroP04"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="#FEF3F2"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="04 Abierta"
                                android:textColor="#B42318"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Puerta 05 -->
                        <LinearLayout
                            android:id="@+id/boxP05"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:background="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Oficinas B"
                                android:textColor="#667085"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvEstadoCuadroP05"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="#EDFDF5"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="05 Cerrada"
                                android:textColor="#027A48"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Puerta 06 -->
                        <LinearLayout
                            android:id="@+id/boxP06"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_margin="2dp"
                            android:background="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Archivo"
                                android:textColor="#667085"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvEstadoCuadroP06"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="#FFFAEB"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="06 Sin datos"
                                android:textColor="#B54708"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </GridLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Plano esquemático · no es un plano de evacuación"
                        android:textColor="#667085"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Leyenda de colores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/leyenda_cerrada"
                    android:textColor="#027A48"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/leyenda_abierta"
                    android:textColor="#B42318"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/leyenda_sin_datos"
                    android:textColor="#B54708"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tarjeta Detalle de la Puerta Seleccionada -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvNombrePuertaSeleccionada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="P2-04 · Escalera A"
                            android:textColor="#101828"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEstadoPuertaSeleccionada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="#FEF3F2"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Abierta"
                            android:textColor="#B42318"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAbrirPuertaPlano"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="#027A48"
                            android:text="@string/btn_abrir_puerta_plano"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnCerrarPuertaPlano"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="#B42318"
                            android:text="@string/btn_cerrar_puerta_plano"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnVerDetallePuerta"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/btn_ver_detalle"
                        android:textColor="#1D2939"
                        app:strokeColor="#1D2939"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón de Llamada Rápida a Emergencias -->
            <Button
                android:id="@+id/btnLlamarEmergenciasPlano"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#B42318"
                android:text="@string/btn_llamar_emergencias"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>