<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos para conectividad IoT y Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permiso obligatorio para enviar notificaciones en Android 13+ (Galaxy S24) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permiso para llamadas telefónicas de emergencia -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartDoorApp">

        <!-- Servicio para recibir Notificaciones Push de Firebase en segundo plano -->
        <service
            android:name=".FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Pantalla principal / Login -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Registro de Usuarios -->
        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de Dashboard / Resumen IoT -->
        <activity
            android:name=".ResumenActivity"
            android:exported="false" />

        <activity
            android:name=".IncendioActivity"
            android:exported="false" />

        <activity
            android:name=".CredencialAperturaActivity"
            android:exported="false" />

        <activity
            android:name=".PuertasActivity"
            android:exported="false" />

        <activity
            android:name=".PlanoActivity"
            android:exported="false" />

        <activity
            android:name=".GestionUsuariosActivity"
            android:exported="false" />

        <activity
            android:name=".AuditoriaActivity"
            android:exported="false" />

        <activity
            android:name=".DebugActivity"
            android:exported="false" />

    </application>

</manifest>